# Telegram token from @BotFather. Keep it private.
BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE

# Random secret Telegram sends in X-Telegram-Bot-Api-Secret-Token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=replace_with_at_least_16_random_characters

# Public HTTPS origin only, e.g. https://your-project.up.railway.app
PUBLIC_BASE_URL=https://your-public-hostname.example

# Telegram chat ID of the one person who administers this bot.
ADMIN_CHAT_ID=

# Separate random value used only for GET /admin/stats.
ADMIN_KEY=replace_with_another_16_plus_character_secret

# Comma-separated chat IDs for all 3 team members; these are excluded from external usage stats.
TEAM_CHAT_IDS=

# For a Railway Volume mounted at /app/persist, use these two absolute paths.
DB_PATH=data/hostel_bot.sqlite3
UPLOAD_DIR=uploads

# Each Telegram file download is limited to 20 MB by default.
MAX_UPLOAD_BYTES=20971520
CONVERSATION_GAP_MINUTES=30
UPDATE_PROCESSING_TTL_SECONDS=300
